APP_NAME=Keel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# --- Host ports --------------------------------------------------------------
# One contiguous block, 8765-8771, chosen to avoid the common defaults (3000,
# 5173, 5432, 6379, 8000, 8025, 8080, 8081) that other projects on your machine
# are likely to have bound.
#
# These are HOST ports only — where your browser and host-side tools connect.
# The container-internal ports further down (DB_PORT, REDIS_PORT, MAIL_PORT) are
# how PHP reaches the other containers over the compose network. Leave those.
#
# This block must stay above APP_URL: Laravel's Dotenv resolves ${APP_PORT} in
# file order, so moving it below would leave APP_URL portless.
#
#   8765  app: UI, /admin, /docs/api, /horizon, /telescope, /health
#   8766  Vite dev server + HMR (same port inside and out)
#   8767  Mailpit web UI
#   8768  pgweb (./keel db-gui)
#   8769  PostgreSQL, for host-side GUI clients
#   8770  Redis, for host-side clients
#   8771  Mailpit SMTP
APP_PORT=8765
VITE_PORT=8766
FORWARD_MAILPIT_DASHBOARD_PORT=8767
PGWEB_PORT=8768
FORWARD_DB_PORT=8769
FORWARD_REDIS_PORT=8770
FORWARD_MAILPIT_PORT=8771

APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=keel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Keel / Docker -----------------------------------------------------------
# Host UID/GID, written by ./keel setup so container-created files are yours.
# WWWUSER=1000
# WWWGROUP=1000

PHP_CLI_SERVER_WORKERS=4

# Host ports live in one block near the top of this file — see "Host ports".

# Xdebug: off | develop,debug | develop,debug,coverage
# SAIL_XDEBUG_MODE=off

# Set when bind-mount file watching doesn't fire (some Docker Desktop setups).
# VITE_USE_POLLING=1

# Observability. Telescope is local-only; Pulse and Horizon sit behind the
# staff panel's authorisation gate.
TELESCOPE_ENABLED=false
PULSE_ENABLED=true
