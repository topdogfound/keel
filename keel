#!/usr/bin/env bash
# Keel — the single entrypoint. Requires Docker; nothing else.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

BOOTSTRAP_IMAGE="laravelsail/php84-composer:latest"
SAIL="vendor/bin/sail"

c_red=$'\033[0;31m'; c_grn=$'\033[0;32m'; c_ylw=$'\033[0;33m'
c_cyn=$'\033[0;36m'; c_bld=$'\033[1m';   c_off=$'\033[0m'

info() { printf '%s➜%s %s\n' "$c_cyn" "$c_off" "$*"; }
ok()   { printf '%s✔%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s!%s %s\n' "$c_ylw" "$c_off" "$*"; }
die()  { printf '%s✖%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

require_docker() {
    docker info >/dev/null 2>&1 || die "Docker isn't running. Start Docker and try again — it's the only thing Keel needs on the host."
}

# Run composer in a throwaway container. This is what breaks the bootstrap cycle:
# compose.yaml builds the app image from ./vendor/laravel/sail/runtimes/8.4, which
# doesn't exist until composer install has run at least once.
#
# --ignore-platform-reqs is required, not incidental. This image ships an older
# PHP (8.4.1) without ext-intl, which filament/support requires, so a fresh
# clone cannot install without it. That is safe here because this container only
# resolves and downloads packages: the application itself only ever runs in the
# Sail image, which is PHP 8.4.24 with the full extension set, and composer.lock
# was resolved against that. Every other command in this script runs there.
bootstrap_composer() {
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
        -v "$PWD":/var/www/html -w /var/www/html \
        "$BOOTSTRAP_IMAGE" composer "$@" --ignore-platform-reqs
}

# Read one key out of .env. Ports are defined there once and everything else --
# compose, Vite, this script -- derives from it, so the banner and the doctor
# scan must not carry their own copies of the numbers.
#
# Deliberately not `source .env`: that would execute arbitrary file contents and
# trip over quoting. A real environment variable still wins, so
# `APP_PORT=9000 ./keel doctor` behaves as you would expect.
env_get() {
    local key="$1" default="${2:-}" val
    val="$(printenv "$key" 2>/dev/null || true)"
    if [ -z "$val" ] && [ -f .env ]; then
        val="$(sed -n "s/^${key}=//p" .env | tail -n1 | tr -d "\"' \t\r")"
    fi
    printf '%s' "${val:-$default}"
}

# Every optional Compose service, and the default set ./keel runs. laravel.test
# (the app) is always on and is not a member of either list.
KEEL_SERVICES_ALL="pgsql redis mailpit horizon scheduler pgweb"
KEEL_SERVICES_DEFAULT="pgsql,redis,mailpit,horizon,scheduler"

# Each optional service in compose.yaml carries a profile named after itself, so
# exporting KEEL_SERVICES as COMPOSE_PROFILES makes every `docker compose` and
# `sail` call below start exactly the configured set with no per-command flags.
# A real KEEL_SERVICES env var still wins -- env_get handles that.
export_profiles() {
    COMPOSE_PROFILES="$(env_get KEEL_SERVICES "$KEEL_SERVICES_DEFAULT")"
    export COMPOSE_PROFILES
}

service_enabled() {
    printf ',%s,' "$(env_get KEEL_SERVICES "$KEEL_SERVICES_DEFAULT")" | grep -q ",$1,"
}

# `docker compose up` starts the active profiles but never stops a profile you
# just dropped, so after `./keel services disable X` the old container lingers
# until the next `down`. Reconcile explicitly. pgweb is exempt: it has its own
# on-demand command (`./keel db-gui`) and is expected to outlive an `up`.
prune_disabled() {
    local svc running
    running="$(docker compose ps --status running --services 2>/dev/null)" || return 0
    for svc in $KEEL_SERVICES_ALL; do
        [ "$svc" = pgweb ] && continue
        service_enabled "$svc" && continue
        printf '%s\n' "$running" | grep -qx "$svc" || continue
        info "Stopping ${svc} — no longer in KEEL_SERVICES"
        docker compose stop "$svc" >/dev/null 2>&1 || true
    done
}

# The end-of-run banner, shared by `setup` and `up`. Only lists services that
# are actually enabled, so a stack without mailpit or horizon doesn't advertise
# a dead URL.
print_urls() {
    local app_port; app_port="$(env_get APP_PORT 8765)"
    echo
    ok "${c_bld}Keel is up.${c_off}"
    printf '  %-14s http://localhost:%s\n'       "App"     "$app_port"
    printf '  %-14s http://localhost:%s/admin\n' "Admin"   "$app_port"
    service_enabled mailpit && printf '  %-14s http://localhost:%s\n' \
        "Mailpit" "$(env_get FORWARD_MAILPIT_DASHBOARD_PORT 8767)"
    service_enabled horizon && printf '  %-14s http://localhost:%s/horizon\n' \
        "Horizon" "$app_port"
    service_enabled pgsql && printf '  %-14s postgres://localhost:%s  (host clients)\n' \
        "Database" "$(env_get FORWARD_DB_PORT 8769)"
    service_enabled redis && printf '  %-14s redis://localhost:%s\n' \
        "Redis" "$(env_get FORWARD_REDIS_PORT 8770)"
    if service_enabled pgweb; then
        printf '  %-14s http://localhost:%s\n' "pgweb" "$(env_get PGWEB_PORT 8768)"
    else
        printf '  %-14s ./keel db-gui  (http://localhost:%s)\n' "pgweb" "$(env_get PGWEB_PORT 8768)"
    fi
    printf '  %-14s http://localhost:%s  (while ./keel dev runs)\n' "Vite" "$(env_get VITE_PORT 8766)"
    echo
    info "Next: run ${c_bld}./keel dev${c_off} for the Vite dev server with HMR."
    echo
}

require_vendor() {
    [ -f "$SAIL" ] || die "vendor/ is missing. Run ${c_bld}./keel setup${c_off} first."
}

sail() { require_vendor; "$SAIL" "$@"; }

wait_for_pgsql() {
    info "Waiting for PostgreSQL to accept connections..."
    for _ in $(seq 1 60); do
        if docker compose exec -T pgsql pg_isready -q 2>/dev/null; then
            ok "PostgreSQL ready"; return 0
        fi
        sleep 2
    done
    die "PostgreSQL didn't become ready in 120s. Check ./keel logs pgsql"
}

cmd_setup() {
    local fresh=0 ci=0
    for a in "$@"; do
        case "$a" in
            --fresh) fresh=1 ;;
            --ci)    ci=1 ;;
            *) die "Unknown flag for setup: $a" ;;
        esac
    done

    require_docker

    if [ "$fresh" = 1 ]; then
        warn "--fresh: destroying containers and volumes (this drops the database)"
        docker compose --profile '*' down -v --remove-orphans || true
    fi

    [ -f .env ] || { cp .env.example .env; ok "Created .env from .env.example"; }

    # Container-created files must belong to the host user, or artisan make:*
    # output ends up root-owned on Linux.
    local uid gid
    uid="$(id -u)"; gid="$(id -g)"
    grep -q '^WWWUSER='  .env && sed -i "s/^WWWUSER=.*/WWWUSER=$uid/"  .env || printf 'WWWUSER=%s\n'  "$uid" >> .env
    grep -q '^WWWGROUP=' .env && sed -i "s/^WWWGROUP=.*/WWWGROUP=$gid/" .env || printf 'WWWGROUP=%s\n' "$gid" >> .env

    # Test for a *usable* install, not merely the directory: a previous run that
    # failed part-way leaves vendor/ present but without vendor/bin, and skipping
    # the install then fails later with a far more confusing error.
    if [ ! -f vendor/autoload.php ] || [ ! -f "$SAIL" ]; then
        info "Installing PHP dependencies (throwaway container, no host PHP needed)..."
        bootstrap_composer install --no-interaction
        [ -f "$SAIL" ] || die "composer install finished but $SAIL is still missing."
        ok "vendor/ ready"
    fi

    info "Building the application image..."
    "$SAIL" build
    info "Starting the stack..."
    "$SAIL" up -d
    service_enabled pgsql && wait_for_pgsql

    grep -q '^APP_KEY=base64:' .env || { "$SAIL" artisan key:generate; }
    "$SAIL" artisan storage:link --quiet || true
    "$SAIL" artisan migrate --seed --force

    info "Installing frontend dependencies (inside the container — never run npm on the host)..."
    "$SAIL" npm install
    # Playwright's OS libraries ship in the Sail image, but the browser binaries do not.
    # PLAYWRIGHT_BROWSERS_PATH=0 puts them in node_modules, so they survive restarts.
    if grep -q '"@playwright/test"' package.json 2>/dev/null; then
        info "Installing Playwright browsers..."
        "$SAIL" npx playwright install chromium
    fi
    # Wayfinder, Inertia and the TypeScript transformer all generate sources at
    # build time. They're gitignored, so a typecheck before the first build
    # always fails on unresolved imports.
    info "Generating TypeScript types from PHP..."
    # The transformer writes into resources/js/types, which normally exists
    # because tracked sources live there. Creating it anyway costs nothing and
    # avoids aborting the whole of setup on a confusing error if it is missing.
    mkdir -p resources/js/types
    "$SAIL" artisan typescript:transform --quiet
    info "Building frontend assets..."
    "$SAIL" npm run build

    [ "$ci" = 1 ] || git config core.hooksPath .githooks 2>/dev/null || true

    print_urls
}

cmd_doctor() {
    local problems=0
    echo "${c_bld}Keel doctor${c_off}"

    if docker info >/dev/null 2>&1; then ok "Docker is running"
    else warn "Docker is not running — nothing else will work"; problems=$((problems+1)); fi

    # Ports this project already publishes. Publishers renders each mapping as
    # "{URL TargetPort PublishedPort Protocol}", e.g. "{0.0.0.0 80 8765 tcp}",
    # so the published (host) port is field 3. Field 2 is the container port,
    # which only matches the host port by coincidence.
    local ours
    ours="$(docker compose --profile '*' ps --format '{{.Publishers}}' 2>/dev/null \
        | grep -oE '\{[^}]+\}' \
        | awk '{print $3}' | sort -u)"

    # Only the app's own ports plus those of the services KEEL_SERVICES actually
    # publishes -- a host Postgres on FORWARD_DB_PORT is the user's own doing
    # once they've dropped the pgsql service, not a conflict to warn about.
    local ports; ports="$(env_get APP_PORT 8765) $(env_get VITE_PORT 8766)"
    service_enabled mailpit && ports="$ports $(env_get FORWARD_MAILPIT_DASHBOARD_PORT 8767) $(env_get FORWARD_MAILPIT_PORT 8771)"
    service_enabled pgweb   && ports="$ports $(env_get PGWEB_PORT 8768)"
    service_enabled pgsql   && ports="$ports $(env_get FORWARD_DB_PORT 8769)"
    service_enabled redis   && ports="$ports $(env_get FORWARD_REDIS_PORT 8770)"

    for p in $ports; do
        if command -v ss >/dev/null && ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$p$"; then
            if ! printf '%s\n' "$ours" | grep -qx "$p"; then
                warn "Port $p is in use by something outside this project (override it in .env)"
                problems=$((problems+1))
            fi
        fi
    done

    [ -d vendor ] || { warn "vendor/ missing — run ./keel setup"; problems=$((problems+1)); }

    # The most common failure: npm run on the host, so the native binaries are
    # built for the wrong platform and Vite dies on a module it cannot load.
    if [ -f package.json ]; then
        if [ ! -d node_modules ]; then
            warn "node_modules is missing — run ./keel npm install"; problems=$((problems+1))
        elif [ ! -d node_modules/@rollup ]; then
            warn "node_modules looks incomplete — run ./keel node-reset"; problems=$((problems+1))
        elif ! ls node_modules/@rollup 2>/dev/null | grep -q linux; then
            warn "node_modules has no linux rollup binary: npm was run on the host, not in the container. Fix: ./keel node-reset"
            problems=$((problems+1))
        fi
    fi

    if [ -f package.json ] && grep -q '"@playwright/test"' package.json; then
        ls node_modules/.cache/ms-playwright >/dev/null 2>&1 || \
        ls node_modules/playwright-core/.local-browsers >/dev/null 2>&1 || \
            warn "Playwright browsers not installed — ./keel npx playwright install chromium"
    fi

    if [ -f .env ]; then
        local missing
        missing="$(comm -23 \
            <(grep -oE '^[A-Z0-9_]+=' .env.example | sort -u) \
            <(grep -oE '^[A-Z0-9_]+=' .env | sort -u) || true)"
        if [ -n "$missing" ]; then
            warn "Keys in .env.example but missing from .env:"; echo "$missing" | sed 's/=$/  /' | sed 's/^/      /'
            problems=$((problems+1))
        fi

        # APP_URL is written by hand and APP_PORT is what actually gets
        # published, so they drift. Every generated link is wrong when they do.
        local app_port url_port
        app_port="$(env_get APP_PORT 8765)"
        url_port="$(sed -n 's|^APP_URL=.*localhost:\([0-9]*\).*|\1|p' .env | tail -n1)"
        if [ -n "$url_port" ] && [ "$url_port" != "$app_port" ]; then
            warn "APP_URL points at :$url_port but APP_PORT publishes :$app_port"
            problems=$((problems+1))
        fi
    else
        warn ".env missing — run ./keel setup"; problems=$((problems+1))
    fi

    # A root-owned analysis cache breaks every later run as the sail user, and
    # the resulting error names a lock file rather than the ownership problem.
    if docker compose ps --status running --quiet laravel.test 2>/dev/null | grep -q .; then
        # -u sail is the whole point: plain exec runs as root, which can write
        # anywhere, so the check would be defeated by the very bug it detects.
        if docker compose exec -T -u sail laravel.test sh -c '[ -d /tmp/phpstan ] && [ ! -w /tmp/phpstan ]' 2>/dev/null; then
            warn "PHPStan's cache is not writable by the app user (something ran as root). Fix: ./keel cache-reset"
            problems=$((problems+1))
        fi
    fi

    if [ -f composer.lock ] && [ -d vendor ] && [ composer.lock -nt vendor ]; then
        warn "composer.lock is newer than vendor/ — run ./keel composer install"; problems=$((problems+1))
    fi

    echo
    [ "$problems" = 0 ] && ok "No problems found." || warn "$problems problem(s) found."
}

# `./keel services` — inspect and toggle which Compose services ./keel runs.
# The list lives in .env as KEEL_SERVICES and is exported to Compose as
# COMPOSE_PROFILES (see export_profiles). laravel.test is always on.
cmd_services() {
    local action="${1:-list}"; [ $# -gt 0 ] && shift || true
    local current; current="$(env_get KEEL_SERVICES "$KEEL_SERVICES_DEFAULT")"

    case "$action" in
        list)
            printf '%b\n' "${c_bld}Keel services${c_off}  (laravel.test is always on)"
            local svc state run
            for svc in $KEEL_SERVICES_ALL; do
                if printf ',%s,' "$current" | grep -q ",$svc,"; then
                    state="${c_grn}enabled ${c_off}"
                else
                    state="${c_ylw}disabled${c_off}"
                fi
                if docker compose ps --status running --quiet "$svc" 2>/dev/null | grep -q .; then
                    run="running"
                else
                    run="stopped"
                fi
                printf '  %-10s %b  %s\n' "$svc" "$state" "$run"
            done
            echo
            info "Toggle with ./keel services {enable|disable} <service>, then ./keel up"
            ;;
        enable|disable)
            local svc="${1:-}"
            [ -n "$svc" ] || die "Usage: ./keel services $action <service>  (one of: $KEEL_SERVICES_ALL)"
            printf ' %s ' "$KEEL_SERVICES_ALL" | grep -q " $svc " \
                || die "Unknown service: $svc  (one of: $KEEL_SERVICES_ALL)"
            [ -f .env ] || die ".env is missing — run ./keel setup first."

            # Rebuild the list in KEEL_SERVICES_ALL order, applying the toggle.
            local want keep new=""
            for want in $KEEL_SERVICES_ALL; do
                keep=0
                printf ',%s,' "$current" | grep -q ",$want," && keep=1
                [ "$want" = "$svc" ] && { [ "$action" = enable ] && keep=1 || keep=0; }
                [ "$keep" = 1 ] && new="${new:+$new,}$want"
            done

            if [ "$new" = "$current" ]; then
                warn "$svc is already ${action}d — nothing to do."
                return 0
            fi

            if grep -q '^KEEL_SERVICES=' .env; then
                sed -i "s/^KEEL_SERVICES=.*/KEEL_SERVICES=$new/" .env
            else
                printf 'KEEL_SERVICES=%s\n' "$new" >> .env
            fi
            ok "${action}d $svc  →  KEEL_SERVICES=$new"
            info "Run ${c_bld}./keel up${c_off} to apply."
            ;;
        *)
            die "Usage: ./keel services [list | enable <svc> | disable <svc>]"
            ;;
    esac
}

usage() {
    cat <<'USAGE'
Keel — Docker-first Laravel monolith

  Lifecycle    setup [--fresh|--ci] · up · down · restart · fresh · doctor
  Develop      dev · build · shell · logs [svc] · artisan … · composer … · npm …
  Quality      test · e2e · lint · types · ts · rector · check
  Data         migrate · seed · psql · redis · tinker · db-gui
  Services     services [list | enable <svc> | disable <svc>]
  Maintenance  node-reset · cache-reset · new <vendor/name>

Everything runs inside Docker. The host needs Docker and git — nothing else.
USAGE
}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

# KEEL_SERVICES -> COMPOSE_PROFILES, so every docker compose / sail call below
# starts exactly the configured service set.
export_profiles

case "$cmd" in
    setup)      cmd_setup "$@" ;;
    doctor)     cmd_doctor "$@" ;;
    services)   cmd_services "$@" ;;
    up)         require_docker
                [ $# -eq 0 ] && prune_disabled
                sail up -d "$@"
                [ $# -eq 0 ] && print_urls || true ;;
    down)       docker compose --profile '*' down "$@" ;;
    restart)    sail restart "$@" ;;
    fresh)      cmd_setup --fresh ;;
    shell)      sail shell ;;
    logs)       sail logs -f "$@" ;;
    dev)        sail npm run dev ;;
    build)      sail npm run build ;;
    test)       sail composer test ;;
    e2e)        sail npx playwright test "$@" ;;
    lint)       sail composer lint ;;
    types)      sail artisan typescript:transform --quiet && sail composer types:check ;;
    ts)         sail artisan typescript:transform ;;
    rector)     sail php vendor/bin/rector process --dry-run "$@" ;;
    check)      sail composer ci:check ;;
    migrate)    sail artisan migrate "$@" ;;
    seed)       sail artisan db:seed "$@" ;;
    psql)       service_enabled pgsql || die "pgsql isn't in KEEL_SERVICES. Use a host client on port $(env_get FORWARD_DB_PORT 8769), or ./keel services enable pgsql"
                sail psql ;;
    redis)      service_enabled redis || die "redis isn't in KEEL_SERVICES. Use a host client on port $(env_get FORWARD_REDIS_PORT 8770), or ./keel services enable redis"
                sail redis ;;
    tinker)     sail tinker ;;
    db-gui)     require_docker; docker compose --profile pgweb up -d pgweb
                ok "pgweb: http://localhost:$(env_get PGWEB_PORT 8768)" ;;
    cache-reset) info "Clearing container caches..."
                docker compose exec -T laravel.test rm -rf /tmp/phpstan
                sail artisan optimize:clear
                ok "Caches cleared" ;;
    node-reset) info "Removing node_modules (host-side; it's a bind mount)..."
                rm -rf node_modules package-lock.json
                sail npm install
                if grep -q '"@playwright/test"' package.json 2>/dev/null; then
                    sail npx playwright install chromium
                fi ;;
    artisan)    sail artisan "$@" ;;
    composer)   sail composer "$@" ;;
    npm)        sail npm "$@" ;;
    npx)        sail npx "$@" ;;
    new)        [ $# -eq 1 ] || die "Usage: ./keel new <vendor/name>"
                bash bin/keel-new.sh "$1" ;;
    ""|-h|--help|help) usage ;;
    *)          die "Unknown command: $cmd  (try ./keel help)" ;;
esac
